# API keys and secrets for tools/ scripts.
# Never commit this file. Never store secrets anywhere else.

# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# https://kie.ai/api-key
KIE_API_KEY=

# Gmail account the newsletter is sent from (must match the Google account
# used to authorize credentials.json / token.json).
GMAIL_SENDER_EMAIL=

# Default recipient when --to is not passed to tools/send_gmail.py.
NEWSLETTER_RECIPIENT=
